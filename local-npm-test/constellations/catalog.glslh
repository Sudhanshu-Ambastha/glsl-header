#include "./stars.glslh"

// Evaluates a single constellation in local coordinates around (0, 0)
vec2 evalConstellation(int id, vec2 p, float time) {
    float lines = 0.0;
    float stars = 0.0;
    float wLine = 0.0045;
    float rStar = 0.022;

    if (id == 0) {
        // Ursa Major (Big Dipper) — 7 links
        vec2 s0 = driftStar(vec2(-0.24,  0.11), time, 0.11);
        vec2 s1 = driftStar(vec2(-0.14,  0.08), time, 0.23);
        vec2 s2 = driftStar(vec2(-0.05,  0.04), time, 0.37);
        vec2 s3 = driftStar(vec2( 0.03,  0.01), time, 0.51);
        vec2 s4 = driftStar(vec2( 0.05, -0.09), time, 0.64);
        vec2 s5 = driftStar(vec2( 0.17, -0.11), time, 0.78);
        vec2 s6 = driftStar(vec2( 0.15, -0.01), time, 0.92);

        lines += drawConstellationLink(p, s0, s1, wLine, time, 0.0, 7.0);
        lines += drawConstellationLink(p, s1, s2, wLine, time, 1.0, 7.0);
        lines += drawConstellationLink(p, s2, s3, wLine, time, 2.0, 7.0);
        lines += drawConstellationLink(p, s3, s4, wLine, time, 3.0, 7.0);
        lines += drawConstellationLink(p, s4, s5, wLine, time, 4.0, 7.0);
        lines += drawConstellationLink(p, s5, s6, wLine, time, 5.0, 7.0);
        lines += drawConstellationLink(p, s6, s3, wLine, time, 6.0, 7.0);

        stars += drawStar(p, s0, rStar, time, 0.11);
        stars += drawStar(p, s1, rStar, time, 0.23);
        stars += drawStar(p, s2, rStar, time, 0.37);
        stars += drawStar(p, s3, rStar, time, 0.51);
        stars += drawStar(p, s4, rStar * 1.15, time, 0.64);
        stars += drawStar(p, s5, rStar * 1.15, time, 0.78);
        stars += drawStar(p, s6, rStar, time, 0.92);
    } else if (id == 1) {
        // Cassiopeia ("W" shape) — 4 links
        vec2 s0 = driftStar(vec2(-0.18,  0.06), time, 0.15);
        vec2 s1 = driftStar(vec2(-0.08, -0.05), time, 0.31);
        vec2 s2 = driftStar(vec2( 0.00,  0.03), time, 0.49);
        vec2 s3 = driftStar(vec2( 0.09, -0.06), time, 0.67);
        vec2 s4 = driftStar(vec2( 0.18,  0.07), time, 0.85);

        lines += drawConstellationLink(p, s0, s1, wLine, time, 0.0, 4.0);
        lines += drawConstellationLink(p, s1, s2, wLine, time, 1.0, 4.0);
        lines += drawConstellationLink(p, s2, s3, wLine, time, 2.0, 4.0);
        lines += drawConstellationLink(p, s3, s4, wLine, time, 3.0, 4.0);

        stars += drawStar(p, s0, rStar, time, 0.15);
        stars += drawStar(p, s1, rStar * 1.1, time, 0.31);
        stars += drawStar(p, s2, rStar, time, 0.49);
        stars += drawStar(p, s3, rStar * 1.1, time, 0.67);
        stars += drawStar(p, s4, rStar, time, 0.85);
    } else if (id == 2) {
        // Orion (shoulders, belt of 3, feet) — 8 links
        vec2 s0 = driftStar(vec2(-0.11,  0.14), time, 0.12);
        vec2 s1 = driftStar(vec2( 0.10,  0.12), time, 0.28);
        vec2 s2 = driftStar(vec2(-0.05,  0.01), time, 0.41);
        vec2 s3 = driftStar(vec2( 0.00,  0.00), time, 0.55);
        vec2 s4 = driftStar(vec2( 0.05, -0.01), time, 0.69);
        vec2 s5 = driftStar(vec2(-0.12, -0.15), time, 0.81);
        vec2 s6 = driftStar(vec2( 0.11, -0.16), time, 0.94);

        lines += drawConstellationLink(p, s0, s1, wLine, time, 0.0, 8.0);
        lines += drawConstellationLink(p, s0, s2, wLine, time, 1.0, 8.0);
        lines += drawConstellationLink(p, s1, s4, wLine, time, 2.0, 8.0);
        lines += drawConstellationLink(p, s2, s3, wLine, time, 3.0, 8.0);
        lines += drawConstellationLink(p, s3, s4, wLine, time, 4.0, 8.0);
        lines += drawConstellationLink(p, s2, s5, wLine, time, 5.0, 8.0);
        lines += drawConstellationLink(p, s4, s6, wLine, time, 6.0, 8.0);
        lines += drawConstellationLink(p, s5, s6, wLine, time, 7.0, 8.0);

        stars += drawStar(p, s0, rStar * 1.2, time, 0.12);
        stars += drawStar(p, s1, rStar, time, 0.28);
        stars += drawStar(p, s2, rStar * 1.05, time, 0.41);
        stars += drawStar(p, s3, rStar * 1.05, time, 0.55);
        stars += drawStar(p, s4, rStar * 1.05, time, 0.69);
        stars += drawStar(p, s5, rStar, time, 0.81);
        stars += drawStar(p, s6, rStar * 1.25, time, 0.94);
    } else if (id == 3) {
        // Cygnus (Northern Cross) — 4 links
        vec2 s0 = driftStar(vec2( 0.00,  0.17), time, 0.19);
        vec2 s1 = driftStar(vec2( 0.00,  0.04), time, 0.38);
        vec2 s2 = driftStar(vec2( 0.00, -0.16), time, 0.57);
        vec2 s3 = driftStar(vec2(-0.15,  0.05), time, 0.73);
        vec2 s4 = driftStar(vec2( 0.15,  0.04), time, 0.91);

        lines += drawConstellationLink(p, s0, s1, wLine, time, 0.0, 4.0);
        lines += drawConstellationLink(p, s1, s2, wLine, time, 1.0, 4.0);
        lines += drawConstellationLink(p, s3, s1, wLine, time, 2.0, 4.0);
        lines += drawConstellationLink(p, s1, s4, wLine, time, 3.0, 4.0);

        stars += drawStar(p, s0, rStar * 1.2, time, 0.19);
        stars += drawStar(p, s1, rStar * 1.1, time, 0.38);
        stars += drawStar(p, s2, rStar, time, 0.57);
        stars += drawStar(p, s3, rStar, time, 0.73);
        stars += drawStar(p, s4, rStar, time, 0.91);
    }

    return vec2(lines, stars);
}